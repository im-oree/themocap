node_modules/
dist/
dist-ssr/
target/
.turbo/
coverage/
*.log
.DS_Store
.vite/
packages/mocap-core-wasm/pkg/
# ORT binaries are copied out of node_modules by scripts/copy-ort-assets.mjs
# on postinstall — generated artifacts, never committed.
apps/web/public/ort/
tools/bench/public/ort/
apps/web/public/models/
tools/bench/public/models/
test-results/
playwright-report/
.env.local
fixtures/*.mp4
tools/bench/public/fixtures/

# npm/yarn lockfiles: this is a pnpm workspace (see scripts/check-package-manager.mjs).
# A stray lockfile here means someone ran the wrong package manager.
package-lock.json
yarn.lock

# Real model weights are supplied out-of-band and are never committed (size +
# license). The generated synthetic placeholder IS committed, so a fresh clone
# can run the pipeline without network access.
apps/web/public/models/*.onnx
!apps/web/public/models/*.stub.onnx
