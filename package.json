{
  "name": "web-mocap-studio",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @wms/web dev",
    "dev:bench": "pnpm --filter @wms/bench dev",
    "build": "pnpm -r build",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "test": "pnpm -r test",
    "test:rust": "cargo test --workspace",
    "build:wasm": "node scripts/build-wasm.mjs",
    "check:no-remote": "node scripts/check-no-remote.mjs",
    "e2e": "pnpm --filter @wms/web e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "node scripts/copy-ort-assets.mjs",
    "preinstall": "node scripts/check-package-manager.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-react": "^7.34.3",
    "eslint-plugin-react-hooks": "^4.6.2",
    "prettier": "^3.3.3",
    "typescript": "^5.5.3"
  }
}
